# ==============================================================================
# SOMI GO PRODUCTION RENDER BACKEND CONFIGURATION
# Copy to .env for local testing. In Render, set these in the Environment tab.
# ==============================================================================

# Server configuration
PORT=10000
NODE_ENV=production
CORS_ORIGIN=*

# Firebase Authentication (Authoritative Identity Layer)
# Firebase Project ID (Matches Android google-services.json)
FIREBASE_PROJECT_ID=somi-go

# Optional: Firebase Admin Service Account JSON or Private Key for Render
# If deploying on Google Cloud / GCP, default application credentials will be used automatically.
# On Render, you can supply FIREBASE_SERVICE_ACCOUNT_BASE64 or FIREBASE_CLIENT_EMAIL & FIREBASE_PRIVATE_KEY
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-somigo@somi-go.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Or provide a single base64 string:
# FIREBASE_SERVICE_ACCOUNT_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCiAgInByb2plY3RfaWQi...

# Supabase Authoritative PostgreSQL Database
# Retrieve these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
