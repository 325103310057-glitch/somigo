# ==============================================================================
# SOMIGO PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure authoritative credentials.
# NEVER commit real production secret keys to version control.
# ==============================================================================

# --- AI Studio & Gemini ---
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# --- Backend API Endpoint (Used by Android app) ---
# For local emulator access use: http://10.0.2.2:8000/api/v1/
# For cloud production use your deployed URL:
BACKEND_API_URL=https://api.somigo.in/api/v1/

# --- Firebase Authentication & Google Sign-In (Client & Backend Identity) ---
# Web Client ID from Google Cloud Console / Firebase Console (for Google Sign-In via Credential Manager)
WEB_CLIENT_ID=your-firebase-web-client-id.apps.googleusercontent.com

# Backend Firebase Admin SDK Credentials (Never package in Android APK)
FIREBASE_PROJECT_ID="somigo-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-somigo@somigo-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""
FIREBASE_CREDENTIALS_PATH=""

# --- Supabase PostgreSQL Production Database ---
# Supabase Project URL & Keys (Never package SUPABASE_SERVICE_ROLE_KEY in Android APK)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authoritative Supabase PostgreSQL direct connection string (Used by Backend)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Payment Gateway (Razorpay / Stripe) ---
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_key

# --- Security & Session ---
SECRET_KEY=somigo_production_jwt_secret_key_change_in_prod_2026
ENVIRONMENT=production

